# Copy to supabase/functions/.env for local runs, or set with `supabase secrets set` (never commit real values).
# RevenueCat API v2 secret key. Scopes: customer_information:customers:read_write (get, create, grant),
# customer_information:subscriptions:read (fresh check, banking), project_configuration:entitlements:read
# (maps the entitlement lookup key, e.g. premium, to RevenueCat's entitlement id). Nothing else.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
# Value RevenueCat sends in the Authorization header of every webhook (sent as entered; the function accepts the raw
# value or "Bearer <value>").
REFERRAL_WEBHOOK_TOKEN=
# RevenueCat webhook signing secret (X-RevenueCat-Webhook-Signature).
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Sent by pg_cron in X-Referral-Worker-Secret; the same value is stored in Vault as referral_worker_secret.
REFERRAL_WORKER_SECRET=
# rewards function (ADR 0002 section 10). Sent by pg_cron as "Authorization: Bearer <value>" to /rewards/worker.
REWARDS_WORKER_SECRET=
# RevenueCat webhook for rewards (a second webhook integration pointing at /functions/v1/rewards/revenuecat): the value
# RevenueCat sends in Authorization, and optionally its signing secret. The worker's in-app currency grants also need
# the RevenueCat key permission customer_information:purchases:read_write.
REWARDS_RC_WEBHOOK_TOKEN=
REWARDS_RC_SIGNING_SECRET=
# Follow-up emails (ADR 0002 18.7): Resend key, sender, app name in the email, and the public base URL of the rewards
# function (for unsubscribe links). Emails stay a dry run unless REWARDS_EMAIL_DRY_RUN=false.
RESEND_API_KEY=
REWARDS_EMAIL_FROM=
REWARDS_EMAIL_REPLY_TO=
REWARDS_APP_NAME=
REWARDS_PUBLIC_URL=
REWARDS_EMAIL_DRY_RUN=
# Meta webhook for Instagram mentions: the verify token you type when subscribing, the Meta app secret (signs every
# POST as X-Hub-Signature-256), and a long-lived token of the app's Instagram professional account (Graph API reads).
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
# Set automatically by Supabase for Edge Functions; needed only for local runs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
