{
  "name": "@myind/rewards-react-native",
  "version": "0.1.0",
  "private": true,
  "description": "React Native widgets for rewards-kit: daily streaks, milestones, timed offers, Instagram tag rewards, daily quizzes, quests, recharges, time windows, friend streaks, weekly leagues, surprise reveals, recaps and follow-up settings, with server-clock countdowns and fair-play choices. Every rewards_kit Flutter widget, with optional Expo adapters for notifications, clipboard and recap share images.",
  "license": "MIT",
  "homepage": "https://www.myind.ai/referral-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaantanu9/referral-rewards-kit.git",
    "directory": "js/packages/rewards-react-native"
  },
  "bugs": "https://github.com/shaantanu9/referral-rewards-kit/issues",
  "keywords": [
    "rewards",
    "gamification",
    "streaks",
    "daily-streak",
    "quiz",
    "quests",
    "leaderboard",
    "leagues",
    "engagement",
    "retention",
    "react-native",
    "expo",
    "supabase",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./notifications": {
      "import": {
        "types": "./dist/notifications.d.ts",
        "default": "./dist/notifications.js"
      },
      "require": {
        "types": "./dist/notifications.d.cts",
        "default": "./dist/notifications.cjs"
      }
    },
    "./clipboard": {
      "import": {
        "types": "./dist/clipboard.d.ts",
        "default": "./dist/clipboard.js"
      },
      "require": {
        "types": "./dist/clipboard.d.cts",
        "default": "./dist/clipboard.cjs"
      }
    },
    "./view-shot": {
      "import": {
        "types": "./dist/view-shot.d.ts",
        "default": "./dist/view-shot.js"
      },
      "require": {
        "types": "./dist/view-shot.d.cts",
        "default": "./dist/view-shot.cjs"
      }
    },
    "./async-storage": {
      "import": {
        "types": "./dist/async-storage.d.ts",
        "default": "./dist/async-storage.js"
      },
      "require": {
        "types": "./dist/async-storage.d.cts",
        "default": "./dist/async-storage.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "jest"
  },
  "dependencies": {
    "@myind/rewards-core": "workspace:*"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=2",
    "expo-clipboard": ">=7",
    "expo-notifications": ">=0.29",
    "react": ">=19",
    "react-native": ">=0.78",
    "react-native-view-shot": ">=4"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "babel-jest": "29.7.0",
    "expo": "58.0.24",
    "expo-clipboard": "58.0.4",
    "expo-notifications": "58.1.9",
    "jest": "29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-view-shot": "6.1.1",
    "test-renderer": "1.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
