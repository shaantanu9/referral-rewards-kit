{
  "name": "@myind/rewards-core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic rewards engine client for Supabase: daily streaks, milestones, quizzes, quests, timed offers, surprises, weekly leagues, recaps and follow-up reminders, with immutable snapshots for React's useSyncExternalStore. The core of rewards-kit for React, Next.js and React Native.",
  "license": "MIT",
  "homepage": "https://www.myind.ai/referral-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaantanu9/referral-rewards-kit.git",
    "directory": "js/packages/rewards-core"
  },
  "bugs": "https://github.com/shaantanu9/referral-rewards-kit/issues",
  "keywords": [
    "rewards",
    "gamification",
    "streaks",
    "daily-streak",
    "milestones",
    "quiz",
    "quests",
    "leaderboard",
    "leagues",
    "loyalty",
    "engagement",
    "retention",
    "supabase",
    "postgrest",
    "revenuecat",
    "react",
    "react-native",
    "nextjs",
    "expo",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
